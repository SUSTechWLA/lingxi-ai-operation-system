{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "loop_id",
    "gate_id",
    "review_type",
    "decision",
    "participants"
  ],
  "properties": {
    "loop_id": {
      "type": "string"
    },
    "gate_id": {
      "type": "string"
    },
    "review_type": {
      "enum": [
        "SELF_REVIEW",
        "MULTI_PERSON_REVIEW"
      ]
    },
    "decision": {
      "enum": [
        "APPROVED",
        "APPROVED_WITH_ACTIONS",
        "PROVISIONALLY_APPROVED",
        "REVISE_AND_RESUBMIT",
        "REJECTED",
        "DEFERRED"
      ]
    },
    "participants": {
      "type": "array",
      "minItems": 1
    }
  }
}
