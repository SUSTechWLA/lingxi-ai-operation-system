{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["theme", "tone", "target_audience", "style_direction"],
  "properties": {
    "theme": {"type": "string", "description": "核心主题"},
    "tone": {"type": "string", "description": "情感基调"},
    "target_audience": {"type": "string", "description": "目标受众"},
    "style_direction": {"type": "string", "description": "风格方向"},
    "suggested_duration_sec": {"type": "number", "description": "建议时长"},
    "suggested_shot_count": {"type": "integer", "minimum": 3, "maximum": 15}
  }
}
