# AIOS Cloud Deployment Configuration
# Copy to .env.cloud and fill in your values

# Required: OpenAI-compatible API
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://api.openai.com/v1

# Database (defaults are fine for docker-compose)
POSTGRES_PASSWORD=changeme

# Auth
AUTH_TOKEN_SECRET=replace-with-a-long-random-secret
AUTH_ACCESS_TOKEN_TTL_SECONDS=3600
AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000

# MinIO object storage
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=changeme

# Feature flags
VIDEO_CREATION_ENABLED=true
LOCAL_RUNNER_ENABLED=false
MODEL_PROVIDER_MODE=real

# Optional: Model Gateway providers
# SEEDANCE_API_KEY=
# GPT_IMAGE_API_KEY=
