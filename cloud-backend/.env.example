# 躺营AI OS 环境变量配置
# 复制此文件为 .env 并填写实际值
# ⚠️ 绝不要将真实的密钥提交到 Git！

# ===================
# OpenAI / LLM 配置
# ===================
OPENAI_API_KEY=your-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=2000
OPENAI_TIMEOUT=60

# ===================
# Kafka / Redpanda 配置
# ===================
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ===================
# 数据库配置
# ===================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=tangying_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-postgres-password
POSTGRES_SSLMODE=disable

# ===================
# Redis 配置
# ===================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ===================
# 服务配置
# ===================
SERVER_PORT=8080
ORCHESTRATOR_URL=http://localhost:8080
CONTEXT_SERVICE_URL=http://localhost:8082

# ===================
# Worker 配置
# ===================
WORKER_TOOL_TIMEOUT=120
WORKER_THREAD_POOL_CORE=10
WORKER_THREAD_POOL_MAX=50

# ===================
# Bash Tool 配置
# ===================
BASH_TOOL_ALLOWED_COMMANDS=*
BASH_TOOL_TIMEOUT=60

# ===================
# MinIO 对象存储配置
# ===================
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=changeme
MINIO_BUCKET=media-assets
MINIO_USE_SSL=false

# ===================
# Sandbox 配置
# ===================
# 沙箱执行环境（可选，开启后 BuildableTool 将通过沙箱执行）
SANDBOX_ENABLED=false
SANDBOX_ADDRESS=localhost:50051
SANDBOX_FALLBACK=true

# ===================
# Video creation / Skills
# ===================
VIDEO_CREATION_ENABLED=true
LOCAL_RUNNER_ENABLED=false
MODEL_PROVIDER_MODE=fake
SKILL_ROOT=skills
