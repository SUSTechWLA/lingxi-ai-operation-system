{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aios.local/schemas/skill-manifest.schema.json",
  "title": "AIOS Skill Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "version",
    "description",
    "workflow",
    "stages"
  ],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "description": {
      "type": "string",
      "minLength": 10
    },
    "workflow": {
      "type": "object",
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "entryInputsSchema": {
      "type": "string"
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "instruction",
          "outputSchema"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "instruction": {
            "type": "string"
          },
          "outputSchema": {
            "type": "string"
          },
          "references": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "templates": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "supports": {
      "type": "object",
      "properties": {
        "stageResume": {
          "type": "boolean"
        },
        "unitRerun": {
          "type": "boolean"
        },
        "manualApproval": {
          "type": "boolean"
        },
        "localExecution": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    }
  }
}
