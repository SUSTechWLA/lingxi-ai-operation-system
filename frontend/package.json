{
  "name": "tangying-frontend",
  "private": true,
  "version": "0.2.1",
  "description": "躺营 AI 视频创作助手桌面客户端",
  "author": "躺营 AI Team",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json && vite build",
    "test:director": "node scripts/director-studio-logic-check.mjs",
    "test:creator": "node scripts/creator-studio-logic-check.mjs",
    "test:settings": "node scripts/settings-theme-check.mjs",
    "test:developer-build": "node scripts/developer-console-build-check.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:3000 && electron .\"",
    "electron:build": "vite build && electron-builder",
    "electron:package:ci": "electron-builder --linux --dir --publish never",
    "electron:prod": "vite build && electron ."
  },
  "dependencies": {
    "axios": "^1.18.1",
    "clsx": "^2.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.6.0",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.4.20",
    "concurrently": "^8.2.2",
    "electron": "^43.1.0",
    "electron-builder": "27.0.0-alpha.3",
    "esbuild": "^0.28.1",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^15.9.0",
    "postcss": "^8.4.20",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.3.6",
    "wait-on": "^8.0.1"
  },
  "overrides": {
    "filelist": "2.0.2"
  },
  "build": {
    "appId": "com.tangying.ai-os",
    "productName": "Tangying AI Video Creation Assistant",
    "artifactName": "Tangying-AI-Video-Creator-${version}-${os}-${arch}.${ext}",
    "icon": "build/icon.png",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "resources/bin/**/*"
    ],
    "extraResources": [
      {
        "from": "resources/bin",
        "to": "bin"
      },
      {
        "from": "../mcp/ip_avatar_3d",
        "to": "mcp/ip_avatar_3d"
      },
      {
        "from": "../mcp/video_qa",
        "to": "mcp/video_qa"
      },
      {
        "from": "../ip-assets/main-ip",
        "to": "ip-assets/main-ip"
      }
    ],
    "mac": {
      "target": "dmg",
      "category": "public.app-category.productivity",
      "minimumSystemVersion": "12.0"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
