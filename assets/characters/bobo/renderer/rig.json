{
  "schemaVersion": "hypergen-ip-puppet/v1",
  "characterId": "bobo",
  "displayName": "波波",
  "sourceReferences": [
    "ip形象/波波/reference.png",
    "ip形象/波波/front.png",
    "ip形象/波波/front-3q-left.png",
    "ip形象/波波/left-side.png",
    "ip形象/波波/right-side.png"
  ],
  "styleNotes": "圆润白色云朵/太空精灵体块，黑色面罩，黄色发光眼睛，头顶绿色小触角，胸前暖色能量心，蓝黄脚部光点。动作年轻、活泼、轻盈。",
  "parts": [
    {"id": "root", "type": "group", "pivot": {"x": 960, "y": 950}, "description": "整角色位移和缩放"},
    {"id": "body", "type": "blob", "pivot": {"x": 960, "y": 650}, "description": "白色云朵身体"},
    {"id": "head", "type": "blob", "pivot": {"x": 960, "y": 500}, "description": "上半身体和面罩承载"},
    {"id": "faceScreen", "type": "screen", "pivot": {"x": 960, "y": 470}, "description": "黑色面罩"},
    {"id": "eyeLeft", "type": "eye", "pivot": {"x": 905, "y": 460}, "description": "左黄色发光眼"},
    {"id": "eyeRight", "type": "eye", "pivot": {"x": 1015, "y": 460}, "description": "右黄色发光眼"},
    {"id": "mouth", "type": "mouth", "pivot": {"x": 960, "y": 520}, "description": "口型切换和开合"},
    {"id": "leftUpperArm", "type": "limb", "pivot": {"x": 790, "y": 645}, "description": "左上臂，可做捧场、平衡和展示预备动作"},
    {"id": "leftForearm", "type": "limb", "pivot": {"x": 735, "y": 700}, "description": "左前臂，可做展开和托举动作"},
    {"id": "leftArm", "type": "limb", "pivot": {"x": 830, "y": 650}, "description": "左手，主要做平衡和捧场动作"},
    {"id": "leftHand", "type": "hand", "pivot": {"x": 735, "y": 735}, "description": "左手掌，可跟随展示动作打开"},
    {"id": "rightUpperArm", "type": "limb", "pivot": {"x": 1090, "y": 645}, "description": "右上臂，可做挥手、指向和强调动作"},
    {"id": "rightForearm", "type": "limb", "pivot": {"x": 1160, "y": 690}, "description": "右前臂，可做挥手和外伸动作"},
    {"id": "rightArm", "type": "limb", "pivot": {"x": 1090, "y": 650}, "description": "右手，主要做挥手、指向、展示动作"},
    {"id": "rightHand", "type": "hand", "pivot": {"x": 1180, "y": 710}, "description": "右手掌，可做指向、挥手和星光强调"},
    {"id": "leftFoot", "type": "foot", "pivot": {"x": 865, "y": 910}, "description": "左脚光点，可做轻微弹跳"},
    {"id": "rightFoot", "type": "foot", "pivot": {"x": 1055, "y": 910}, "description": "右脚光点，可做轻微弹跳"},
    {"id": "antenna", "type": "prop", "pivot": {"x": 1030, "y": 340}, "description": "绿色触角，用于情绪脉冲"},
    {"id": "heartCore", "type": "prop", "pivot": {"x": 960, "y": 710}, "description": "胸前能量心"},
    {"id": "feetGlow", "type": "prop", "pivot": {"x": 960, "y": 900}, "description": "蓝黄脚部光点"}
  ],
  "mouthShapes": ["mouth_closed", "mouth_e", "mouth_i", "mouth_a", "mouth_o", "mouth_u"],
  "motionChannels": {
    "bodyFloat": {"range": [-18, 18], "unit": "px", "default": 0},
    "headTilt": {"range": [-8, 8], "unit": "deg", "default": 0},
    "mouthOpen": {"range": [0, 1], "unit": "ratio", "default": 0},
    "blink": {"range": [0, 1], "unit": "ratio", "default": 0},
    "leftArmReach": {"range": [0, 1], "unit": "ratio", "default": 0},
    "leftArmLift": {"range": [0, 1], "unit": "ratio", "default": 0},
    "rightArmReach": {"range": [0, 1], "unit": "ratio", "default": 0},
    "rightArmLift": {"range": [0, 1], "unit": "ratio", "default": 0},
    "bothHandsPresent": {"range": [0, 1], "unit": "ratio", "default": 0},
    "footBounce": {"range": [0, 1], "unit": "ratio", "default": 0},
    "bodySway": {"range": [-1, 1], "unit": "ratio", "default": 0},
    "bodyTilt": {"range": [-8, 8], "unit": "deg", "default": 0},
    "rightArmWave": {"range": [0, 1], "unit": "ratio", "default": 0},
    "glowPulse": {"range": [0, 1], "unit": "ratio", "default": 0.5},
    "squashStretch": {"range": [-0.04, 0.04], "unit": "ratio", "default": 0}
  },
  "motions": [
    {"name": "idle_breath", "channels": ["bodyFloat", "squashStretch", "glowPulse"]},
    {"name": "idle_hands", "channels": ["leftArmReach", "rightArmReach"]},
    {"name": "body_weight_shift", "channels": ["bodySway", "bodyTilt"]},
    {"name": "foot_bounce", "channels": ["footBounce", "bodyFloat"]},
    {"name": "blink", "channels": ["blink"]},
    {"name": "head_nod", "channels": ["bodyFloat", "headTilt"]},
    {"name": "gesture_right_point", "channels": ["rightArmReach", "rightArmLift", "glowPulse"]},
    {"name": "gesture_left_present", "channels": ["leftArmReach", "leftArmLift", "bodyTilt"]},
    {"name": "gesture_both_present", "channels": ["leftArmReach", "rightArmReach", "bothHandsPresent"]},
    {"name": "gesture_wave", "channels": ["rightArmWave", "glowPulse"]}
  ],
  "hypergenUsage": {
    "recommendedLayer": "hypergen",
    "bindLipSync": "mouthOpen <- lip_sync_timeline.open; mouth shape <- lip_sync_timeline.mouth",
    "bindMotion": "motion_timeline.motion drives named motions above",
    "safeTextZones": ["right_side", "lower_third"]
  }
}
