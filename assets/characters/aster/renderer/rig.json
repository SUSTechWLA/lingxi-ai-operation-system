    {"id": "head", "type": "helmet", "pivot": {"x": 960, "y": 430}, "description": "白色三角头盔"},
    {"id": "faceScreen", "type": "screen", "pivot": {"x": 960, "y": 450}, "description": "黑色面屏"},
