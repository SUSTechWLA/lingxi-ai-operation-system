{
  "name": "tangying-ai-operation-system",
  "version": "0.2.1",
  "private": true,
  "scripts": {
    "frontend:dev": "bash scripts/start-frontend.sh",
    "local-backend:dev": "bash scripts/start-local-backend.sh",
    "cloud-backend:dev": "bash scripts/start-cloud-backend.sh",
    "desktop:build": "bash scripts/build-local-desktop.sh",
    "deploy": "bash scripts/one-click-deploy.sh up",
    "deploy:status": "bash scripts/one-click-deploy.sh status",
    "deploy:down": "bash scripts/one-click-deploy.sh down",
    "test:deploy": "python3 -m unittest scripts/test_one_click_deploy.py",
    "test:beta-smoke": "cd frontend && npm run test:director && cd ../cloud-backend && go test ./internal/core/localrunner",
    "test:observability-contract": "node scripts/verify-observability-contract.mjs",
    "electron:dev": "cd frontend && npm run electron:dev",
    "electron:build": "bash scripts/build-local-desktop.sh"
  }
}
